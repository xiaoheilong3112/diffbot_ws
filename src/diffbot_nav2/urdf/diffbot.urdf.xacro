<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffbot">

  <!-- ========================================== -->
  <!-- 1. 物理参数与惯性张量 (Inertia) 计算宏       -->
  <!-- ========================================== -->
  <xacro:property name="chassis_mass"   value="6.0"/> <!-- kg -->
  <xacro:property name="chassis_length" value="0.45"/> <!-- X 方向 (m) -->
  <xacro:property name="chassis_width"  value="0.30"/> <!-- Y 方向 (m) -->
  <xacro:property name="chassis_height" value="0.12"/> <!-- Z 方向 (m) -->

  <xacro:property name="wheel_mass"     value="0.8"/>
  <xacro:property name="wheel_radius"   value="0.08"/> <!-- 8 cm -->
  <xacro:property name="wheel_width"    value="0.04"/> <!-- 4 cm -->
  <xacro:property name="wheel_track"    value="0.34"/> <!-- 轮距 (m) -->

  <xacro:property name="caster_mass"    value="0.3"/>
  <xacro:property name="caster_radius"  value="0.04"/> <!-- 4 cm -->

  <!-- 实用惯性矩阵宏：长方体 -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(w*w + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(1.0/12.0)*m*(l*l + h*h)}" iyz="0.0"
               izz="${(1.0/12.0)*m*(l*l + w*w)}"/>
    </inertial>
  </xacro:macro>

  <!-- 实用惯性矩阵宏：圆柱体 (绕 Z 轴旋转对称) -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(1.0/12.0)*m*(3*r*r + h*h)}" iyz="0.0"
               izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ========================================== -->
  <!-- 2. 坐标基准: base_footprint 与 base_link   -->
  <!-- ========================================== -->
  <!-- base_footprint 位于机器人地面水平投影处 (Z=0)，符合 REP-105 规范 -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- 将 base_link 抬升至轮子半径高度 -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- 底盘本体 Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" l="${chassis_length}" w="${chassis_width}" h="${chassis_height}"/>
  </link>

  <!-- ========================================== -->
  <!-- 3. 左右主动驱动轮 (连续旋转关节)            -->
  <!-- ========================================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <!-- 默认圆柱沿 Z 轴，旋转 90 度与 Y 轴平行对齐 -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="rubber_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/> <!-- 绕 Y 轴滚动 -->
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_offset="${wheel_track/2}"/>
  <xacro:wheel prefix="right" y_offset="-${wheel_track/2}"/>

  <!-- ========================================== -->
  <!-- 4. 前端从动万向支撑轮 (球形)                -->
  <!-- ========================================== -->
  <link name="caster_wheel_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia ixx="${(2.0/5.0)*caster_mass*caster_radius*caster_radius}" ixy="0" ixz="0"
               iyy="${(2.0/5.0)*caster_mass*caster_radius*caster_radius}" iyz="0"
               izz="${(2.0/5.0)*caster_mass*caster_radius*caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <!-- 偏置安装在前端，Z 轴落至与地面相切 -->
    <origin xyz="${chassis_length/2 - 0.06} 0 -${wheel_radius - caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- 5. 2D 激光雷达传感器 Link                   -->
  <!-- ========================================== -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.12 0 ${chassis_height + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- 6. 6 轴 IMU 惯导单元 Link (中心刚体安装)   -->
  <!-- ========================================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="imu_red">
        <color rgba="0.9 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- 安装在机器人几何与旋转质心处 -->
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- 引入 Gazebo 插件与材质定义 -->
  <xacro:include filename="$(find diffbot_nav2)/urdf/diffbot_gazebo.xacro"/>

</robot>
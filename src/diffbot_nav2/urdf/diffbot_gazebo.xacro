<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- 1. 万向轮无摩擦力配置 (防止转向打滑卡死)     -->
  <!-- ========================================== -->
  <gazebo reference="caster_wheel_link">
    <mu1>0.0001</mu1>
    <mu2>0.0001</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ========================================== -->
  <!-- 2. Gazebo Sim 两轮差速驱动系统插件          -->
  <!-- ========================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- 轮子关节映射 -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      
      <!-- 运动学参数 -->
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.08</wheel_radius>

      <!-- 限制与平滑 -->
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      
      <!-- 话题接口与坐标系 (发布未滤波的原始里程计) -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom/unfiltered</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>50</odom_publisher_frequency>

      <!-- 核心避坑：严禁在此处发布 /tf！TF 统一由 robot_localization EKF 独占广播 -->
      <!-- <tf_topic>/tf</tf_topic> 已注释禁用 -->
    </plugin>
  </gazebo>

  <!-- ========================================== -->
  <!-- 3. 2D 激光雷达 (GPU Lidar) 仿真传感器       -->
  <!-- ========================================== -->
  <gazebo reference="laser_link">
    <sensor name="diffbot_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>30</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1440</samples>   <!-- 0.25deg: 束距<5cm@8m, 单一起点 raytrace 无死角 -->
            <resolution>1.0</resolution>
            <min_angle>-3.1415926</min_angle>
            <max_angle>3.1415926</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev> <!-- 模拟毫米级高斯测距噪波 -->
        </noise>
      </ray>
      <always_on>true</always_on>
      <visualize>false</visualize>  <!-- 关闭射线可视化, 降低 gpu_lidar 渲染负担 -->
    </sensor>
  </gazebo>

  <!-- ========================================== -->
  <!-- 4. gz_ros2_control 硬件接口插件 (机械臂)     -->
  <!-- ========================================== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find diffbot_nav2)/config/ros2_controllers.yaml</parameters>
      <controller_manager_node_name>controller_manager</controller_manager_node_name>
    </plugin>
  </gazebo>

  <!-- ========================================== -->
  <!-- 5. 6 轴 IMU 仿真传感器 (含高斯噪波仿真)     -->
  <!-- ========================================== -->
  <gazebo reference="imu_link">
    <sensor name="diffbot_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>